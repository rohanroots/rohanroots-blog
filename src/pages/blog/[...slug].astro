---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image}>
  <article class="post">
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{date}</time>
      {post.data.canonical && (
        <div class="canonical-note" style="margin-top: 1rem;">
          Originally published on <a href={post.data.canonical}>Substack</a>.
        </div>
      )}
    </div>
    <Content />
  </article>
</BaseLayout>

<style>
  /* Article content styles live here (not in BaseLayout): Astro scopes
     selectors to the component that renders the markup, so these must sit
     next to <article class="post"> to match. Markdown descendants still
     need :global() since markdown elements get no scope attribute. */
  .post h1 { font-size: 2rem; line-height: 1.25; margin: 0 0 0.5rem; }
  .post .meta { color: var(--muted); font-size: 0.95rem; margin-bottom: 2rem; }
  .post :global(h2) { color: var(--amber); margin-top: 2.5rem; font-size: 1.4rem; }
  .post :global(p) { margin: 1.1rem 0; }
  .post :global(ul), .post :global(ol) { padding-left: 1.4rem; }
  .post :global(li) { margin: 0.6rem 0; }
  .post :global(blockquote) { border-left: 3px solid var(--teal); margin: 1.5rem 0; padding: 0.25rem 0 0.25rem 1rem; color: var(--muted); }
  .post :global(table) { border-collapse: collapse; width: 100%; margin: 1.5rem 0; font-size: 0.95rem; }
  .post :global(th), .post :global(td) { border: 1px solid var(--border); padding: 0.6rem 0.8rem; text-align: left; }
  .post :global(th) { background: var(--surface); color: var(--amber); }
  .post :global(code) { background: var(--surface); padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.9em; }
  .post :global(pre) { background: var(--surface); padding: 1rem; border-radius: 8px; overflow-x: auto; }
  .post :global(pre code) { background: none; padding: 0; }
  .post :global(img) { max-width: 100%; height: auto; border-radius: 8px; }
  .post :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }
</style>
