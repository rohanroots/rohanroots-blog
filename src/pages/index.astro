---
/* Hallmark · v2.0.0 · genre: editorial · macrostructure: Index-First · theme: Nightshift (custom-tuned, locked by design.md) · redesign: full · hero: Banner · design-system: design.md */

import BaseLayout from '../layouts/BaseLayout.astro';
import PostRows from '../components/PostRows.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="rohan roots">
  <div class="home gutter">
    <h1 class="home__head">Notes from the on-call shift. Newest first.</h1>
    <PostRows posts={posts} />
    <p class="home__more"><a href="/archive">Browse the archive</a></p>
  </div>
</BaseLayout>

<style>
  .home { max-width: 90rem; margin: 0 auto; }
  .home__head {
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-base);
    color: var(--color-ink-2);
    margin: 0 0 var(--space-md);
  }
  .home__more { margin: var(--space-xl) 0 0; font-size: var(--text-base); }
  .home__more a {
    color: var(--color-ink);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color var(--dur-short) var(--ease-out);
  }
  .home__more a:hover { color: var(--color-accent); }
  .home__more a:active { color: var(--color-accent); }
</style>
