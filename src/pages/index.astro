---
/* Hallmark · v2.0.0 · genre: atmospheric · theme: custom (the Logbook) · redesign: full · hero: the opened logbook, the standfirst over the entries */

import BaseLayout from '../layouts/BaseLayout.astro';
import PostRows from '../components/PostRows.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="rohan roots">
  <div class="home">
    <h1 class="home__head">Notes from the on-call shift. Newest first.</h1>
    <PostRows posts={posts} lead />
    <p class="home__more"><a href="/archive">Browse the archive</a></p>
  </div>
</BaseLayout>

<style>
  .home__head {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-display-s);
    letter-spacing: var(--tracking-display);
    line-height: 1.08;
    color: var(--color-ink);
    margin: 0 0 var(--space-2xl);
    max-width: 16ch;
    overflow-wrap: break-word;
    min-width: 0;
  }
  .home__more { margin: var(--space-xl) 0 0; font-size: var(--text-md); }
  .home__more a {
    color: var(--color-ink);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color var(--dur-short) var(--ease-out);
  }
  .home__more a:hover { color: var(--color-accent); }
  .home__more a:active { color: var(--color-accent); }
</style>
