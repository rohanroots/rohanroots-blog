---
/* Hallmark · v2.0.0 · genre: editorial · macrostructure: site-chrome · theme: Nightshift (custom-tuned, locked by design.md) · redesign: full · hero: Banner · nav: N6 · footer: Ft4 · design-system: design.md */

import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Notes on AI agents, self-hosting, and infra.', image = '/header.png' } = Astro.props;
const siteTitle = 'rohan roots';
const siteUrl = 'https://rohanroots.dev';
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/jpeg" href="/avatar.jpg" />
    <link rel="alternate" type="application/rss+xml" title="rohan roots RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,100..900&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <style is:global>
      html, body { overflow-x: clip; }
    </style>
    <style>
      /* N6 newspaper masthead + Ft4 colophon. Knobs: issue-line above wordmark
         (serif, sentence case, untracked), wordmark 2xl lowercase, double rule. */
      .masthead { text-align: center; padding: var(--space-xl) var(--gutter) 0; }
      .masthead__line {
        font-size: var(--text-sm);
        color: var(--color-ink-2);
        margin: 0 0 var(--space-sm);
      }
      .masthead__wordmark {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(2.5rem, 6vw, 4rem);
        letter-spacing: -0.02em;
        line-height: 1;
        color: var(--color-ink);
        text-decoration: none;
        display: inline-block;
        overflow-wrap: anywhere;
        text-wrap: balance;
      }
      .masthead__wordmark:hover { color: var(--color-accent); }
      .masthead__nav {
        margin-top: var(--space-md);
        display: flex;
        justify-content: center;
        gap: var(--space-lg);
        font-size: var(--text-sm);
      }
      .masthead__nav a {
        color: var(--color-ink-2);
        text-decoration: none;
        white-space: nowrap;
        padding-bottom: var(--space-3xs);
        border-bottom: 1px solid transparent;
        transition: color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out);
      }
      .masthead__nav a:hover { color: var(--color-ink); }
      .masthead__nav a:active { color: var(--color-accent); }
      .masthead__nav a[aria-current="page"] {
        color: var(--color-accent);
        border-bottom-color: var(--color-accent);
      }
      .masthead__rule {
        border: 0;
        border-top: 1px solid var(--color-rule);
        border-bottom: 1px solid var(--color-rule);
        height: 5px;
        margin: var(--space-md) 0 0;
      }
      main { padding: var(--space-xl) 0 var(--space-3xl); }
      .colophon {
        border-top: 1px solid var(--color-rule);
        padding-block: var(--space-lg);
      }
      .colophon p {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: 1.9;
        color: var(--color-ink-2);
        margin: 0;
        max-width: 75ch;
      }
      .colophon a {
        color: var(--color-ink-2);
        text-decoration: underline;
        text-decoration-color: var(--color-rule);
        text-underline-offset: 2px;
      }
      .colophon a:hover {
        color: var(--color-accent);
        text-decoration-color: var(--color-accent);
      }
      .colophon a:active { color: var(--color-accent); }
      @media (max-width: 40rem) {
        .masthead__nav { gap: var(--space-md); flex-wrap: wrap; }
      }
    </style>
  </head>
  <body>
    <header class="masthead">
      <p class="masthead__line">Notes on AI agents, self-hosting, and infra.</p>
      <a class="masthead__wordmark" href="/">rohan roots</a>
      <nav class="masthead__nav" aria-label="Primary">
        <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
        <a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
        <a href="/archive" aria-current={isCurrent('/archive') ? 'page' : undefined}>Archive</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <hr class="masthead__rule" aria-hidden="true" />
    </header>
    <main>
      <slot />
    </main>
    <footer class="colophon gutter">
      <p>
        rohan roots. Set in Fraunces, Newsreader &amp; JetBrains Mono.
        Built with Astro, shipped on Cloudflare Pages. No trackers, no cookies.
        <a href="/rss.xml">RSS</a>
      </p>
    </footer>
  </body>
</html>
