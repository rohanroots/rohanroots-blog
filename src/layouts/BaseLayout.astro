---
/* Hallmark · v2.0.0 · genre: atmospheric · theme: custom (the Logbook) · redesign: full · hero: the opened logbook · nav: the margin rail · footer: the endpaper colophon */

import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Notes on AI agents, self-hosting, and infra.', image = '/header.png' } = Astro.props;
const siteTitle = 'rohan roots';
const siteUrl = 'https://rohanroots.dev';
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/jpeg" href="/avatar.jpg" />
    <link rel="alternate" type="application/rss+xml" title="rohan roots RSS" href="/rss.xml" />
    <title>{fullTitle}</title>
    <style is:global>
      html, body { overflow-x: clip; }
    </style>
    <style>
      /* The margin rail: a full-height endpaper band at the page's left.
         The header sits inside it, stuck, while the entries scroll past;
         the red rule itself runs down the record in the main column. */
      .page {
        max-width: var(--container);
        margin-inline: auto;
        padding-inline: var(--gutter);
        display: grid;
        grid-template-columns: var(--rail) minmax(0, 1fr);
        grid-template-areas: "side main" "side foot";
        column-gap: var(--gap-columns);
      }
      .rail {
        grid-area: side;
        background: var(--color-paper-2);
        border-right: 1px solid var(--color-rule);
        padding: var(--space-xl) var(--space-lg) var(--space-xl) var(--space-md);
      }
      .side { position: sticky; top: var(--space-xl); }
      .side__wordmark {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-xl);
        white-space: nowrap;
        word-spacing: 0.045em;
        letter-spacing: var(--tracking-display);
        line-height: 1.05;
        color: var(--color-ink);
        text-decoration: none;
        display: inline-block;
        overflow-wrap: break-word;
        min-width: 0;
        transition: color var(--dur-short) var(--ease-out);
      }
      .side__wordmark:hover { color: var(--color-accent); }
      .side__wordmark:active { color: var(--color-accent); }
      .side__tagline {
        font-size: var(--text-sm);
        line-height: 1.55;
        color: var(--color-ink-2);
        margin: var(--space-md) 0 0;
        max-width: 26ch;
      }
      .side__nav {
        margin-top: var(--space-2xl);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-sm);
        font-size: var(--text-md);
      }
      .side__nav a {
        color: var(--color-ink-2);
        text-decoration: none;
        white-space: nowrap;
        transition: color var(--dur-short) var(--ease-out);
      }
      .side__nav a:hover { color: var(--color-ink); }
      .side__nav a:active { color: var(--color-accent); }
      .side__nav a[aria-current="page"] { color: var(--color-accent); }
      main { grid-area: main; padding: var(--space-xl) 0 var(--space-2xl); min-width: 0; }
      .colophon {
        grid-area: foot;
        border-top: 1px solid var(--color-rule);
        padding-block: var(--space-md) var(--space-lg);
      }
      .colophon p {
        font-family: var(--font-outlier);
        font-size: var(--text-xs);
        line-height: 1.9;
        color: var(--color-ink-2);
        margin: 0;
        max-width: 75ch;
      }
      .colophon a {
        color: var(--color-ink-2);
        text-decoration: underline;
        text-decoration-color: var(--color-rule);
        text-underline-offset: 2px;
        transition: color var(--dur-short) var(--ease-out), text-decoration-color var(--dur-short) var(--ease-out);
      }
      .colophon a:hover {
        color: var(--color-accent);
        text-decoration-color: var(--color-accent);
      }
      .colophon a:active { color: var(--color-accent); }
      @media (max-width: 60rem) {
        .page { grid-template-columns: minmax(0, 1fr); grid-template-areas: "side" "main" "foot"; }
        .rail {
          border-right: 0;
          border-bottom: 1px solid var(--color-rule);
          padding: var(--space-lg) var(--space-md) var(--space-lg);
        }
        .side { position: static; }
        .side__tagline { max-width: 65ch; }
        .side__nav {
          margin-top: var(--space-lg);
          flex-direction: row;
          flex-wrap: wrap;
          gap: var(--space-md) var(--space-lg);
        }
        main { padding-top: var(--space-lg); }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="rail">
        <header class="side">
          <a class="side__wordmark" href="/" aria-label="rohan roots, home">rohan roots</a>
          <p class="side__tagline">Notes on AI agents, self-hosting, and infra.</p>
          <nav class="side__nav" aria-label="Primary">
            <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
            <a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
            <a href="/archive" aria-current={isCurrent('/archive') ? 'page' : undefined}>Archive</a>
            <a href="/rss.xml">RSS</a>
          </nav>
        </header>
      </div>
      <main>
        <slot />
      </main>
      <footer class="colophon">
        <p>
          rohan roots. Set in Clash Display, Spectral &amp; IBM Plex Mono.
          Built with Astro, shipped on Cloudflare Pages. No trackers, no cookies. <a href="/rss.xml">RSS</a>
        </p>
      </footer>
    </div>
  </body>
</html>
